{
  "name": "@webship.co/workspace-svelte",
  "version": "1.0.0",
  "description": "Svelte for Webship Workspace: the builder (`cmd-svelte-project.sh`) in every sites folder, which makes a SvelteKit app with the official create flow (or takes one from its repository), builds it with the Node adapter and serves it from a container of its own (Node.js in the app's container; DDEV by default, or Docker Compose, Podman or Kubernetes with --runtime), the Svelte step pack wired into the testing setup of such an app, and its AI items in their folders: two agents, a skill, a command and two prompts for building and testing SvelteKit apps.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-svelte.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "svelte",
    "label": "Svelte",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-svelte-project.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-svelte.sh"
      ],
      "args": [
        "scripts/args/arg-svelte.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/svelte-app-builder.md",
        "ai/agents/svelte-tester.md"
      ],
      "skills": [
        "ai/skills/svelte-scenarios"
      ],
      "commands": [
        "ai/commands/svelte-test.md"
      ],
      "prompts": [
        "ai/prompts/svelte-build-and-test.md",
        "ai/prompts/svelte-scenarios-for-an-app.md"
      ]
    },
    "features": [
      "features/svelte.feature",
      "features/svelte-runtimes.feature"
    ],
    "featuresSite": "cmd-svelte-project.sh ci-svelte --install --runtime docker"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.13",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
